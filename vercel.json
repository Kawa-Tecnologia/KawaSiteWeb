{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "kawa-site-web-ten.vercel.app" }
      ],
      "destination": "https://www.kawatecnologia.com.br/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "kawa-site-web-ten.vercel.app" }
      ],
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}